    "@types/react-dom": "^19.2.3",
    "@types/react-router-bootstrap": "^0.26.6",
    "@types/react-slick": "^0.23.13",
    "bootstrap": "^5.3.2",
    "chrono-node": "^2.9.1",
    "exif": "^0.6.0",
    "exif-js": "^2.3.0",
    "exifr": "^7.1.3",
    "exifreader": "^4.19.1",
    "family-chart": "^0.9.0",
