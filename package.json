{
  "name": "family-files",
  "version": "0.1.0",
  "private": true,
  "main": "public/main.js",
  "homepage": "./",
  "dependencies": {
    "@electron/remote": "^2.1.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/exif": "^0.6.5",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.68",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-router-bootstrap": "^0.26.6",
    "@types/react-slick": "^0.23.13",
    "bootstrap": "^5.3.2",
    "chrono-node": "^2.9.1",
    "exif": "^0.6.0",
    "exif-js": "^2.3.0",
    "exifr": "^7.1.3",
    "exifreader": "^4.19.1",
    "family-chart": "^0.9.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.1",
    "react-dom": "^18.2.0",
    "react-router-bootstrap": "^0.26.2",
    "react-router-dom": "^6.21.0",
    "react-scripts": "5.0.1",
    "react-slick": "^0.29.0",
    "read-gedcom": "^0.3.2",
    "slick-carousel": "^1.8.1",
    "styled-components": "^6.1.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "electron .",
    "dist": "react-scripts build && electron-builder --mac"
  },
  "build": {
    "extends": null,
    "appId": "com.chrislucas.familyfiles",
    "productName": "Family Files",
    "mac": {
      "category": "public.app-category.lifestyle"
    },
    "files": [
      "build/**/*",
      "public/main.js",
      "node_modules/**/*"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1"
  }
}
